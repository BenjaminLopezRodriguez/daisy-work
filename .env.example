# Local secrets — copy to `.env` (never commit `.env`)

# Neon (pooled for app runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Neon direct (migrations / drizzle push)
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"

# Optional — DeepSeek orchestrator (falls back to heuristic mock)
DEEPSEEK_API_KEY=""
# DEEPSEEK_BASE_URL="https://api.deepseek.com"
# DEEPSEEK_MODEL="deepseek-chat"
