# Copy to .env and fill in. Never commit real values.
# NOTE: `vercel env pull` writes to .env — do not point it at this file.

# Neon Postgres. Pooled for the app, unpooled for `pnpm db:push`.
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

# Auth.js v5.
#   AUTH_SECRET: openssl rand -base64 32
#   Google credentials: Google Cloud Console -> Credentials
#   Redirect URI: <origin>/api/auth/callback/google
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# DeepSeek. Optional — without a key the orchestrator falls back to heuristics.
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL=""
DEEPSEEK_MODEL=""

# UploadThing (Dashboard -> API Keys). Prefer TOKEN (v7).
UPLOADTHING_TOKEN=""
UPLOADTHING_APP_ID=""
